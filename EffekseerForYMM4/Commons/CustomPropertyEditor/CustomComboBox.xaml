<UserControl x:Class="EffekseerForYMM4.Commons.CustomPropertyEditor.CustomComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="this">
    <Grid Height="26">
        <ComboBox x:Name="PART_ComboBox"
                  ItemsSource="{Binding ElementName=this, Path=CustomViewModel.ItemsSource}"
                  SelectedItem="{Binding ElementName=this, Path=CustomViewModel.SelectedValue, Mode=OneWay}"
                  SelectionChanged="ComboBox_SelectionChanged"
                  IsEnabled="{Binding ElementName=this, Path=CustomViewModel.IsEnabled}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayMember}"
                               ToolTip="{Binding ToolTipMember}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
